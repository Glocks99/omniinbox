PORT=5000
MONGO_URI=mongodb://localhost:27017/omniinbox
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Optional: defaults to the local demo admin account ID (user_admin).
# Create a bot with https://t.me/BotFather. Keep this secret on the server only.
# Optional: defaults to the local demo admin account ID (user_admin).
TELEGRAM_OWNER_ID=user_admin
# Create a bot with https://t.me/BotFather. Keep this secret in server/.env only.
TELEGRAM_BOT_TOKEN=
# Generate a VAPID key pair for Web Push; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
